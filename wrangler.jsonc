{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "calorie",
  "main": "src/worker.ts",
  "compatibility_date": "2026-07-25",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    {
      "pattern": "calorie.significanthobbies.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "calorie",
      "database_id": "1818a09c-4b01-4212-a688-c9b9682ef189",
      "migrations_dir": "migrations"
    }
  ],
  "placement": {
    "mode": "smart"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  },
  "secrets": {
    "required": [
      "APPLE_CLIENT_ID",
      "APPLE_CLIENT_SECRET",
      "APPLE_APP_BUNDLE_IDENTIFIER"
    ]
  }
}
