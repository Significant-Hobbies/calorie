{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "calorie",
  "main": "src/worker.ts",
  "compatibility_date": "2026-07-25",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "APPLE_APP_BUNDLE_IDENTIFIER": "com.significanthobbies.calorie",
    "AUTH0_ISSUER": "https://dev-0suel086hm1blvg7.us.auth0.com/",
    "AUTH0_MCP_AUDIENCE": "https://mcp.significanthobbies.com/calorie/mcp"
  },
  "routes": [
    {
      "pattern": "calorie.significanthobbies.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": ["/api/*", "/v1/*", "/app", "/app/*", "/openapi.json", "/openapi.yaml", "/llms.txt", "/llms-full.txt", "/index.md", "/sitemap.xml", "/robots.txt"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "calorie",
      "database_id": "1818a09c-4b01-4212-a688-c9b9682ef189",
      "migrations_dir": "migrations"
    }
  ],
  "services": [
    {
      "binding": "AUTH_SERVICE",
      "service": "significanthobbies"
    }
  ],
  "placement": {
    "mode": "smart"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  }
}
