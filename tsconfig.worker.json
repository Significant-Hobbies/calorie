{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": ["@cloudflare/workers-types"]
  },
  "include": [
    "worker-configuration.d.ts",
    "src/worker.ts",
    "src/worker/**/*.ts",
    "src/server/**/*.ts",
    "src/lib/types.ts",
    "src/lib/recommendations.ts",
    "src/lib/daily-action-preferences.ts",
    "src/lib/entries.ts",
    "src/lib/food-context.ts",
    "src/lib/goal-cycles.ts",
    "src/lib/journal-export.ts"
  ]
}
